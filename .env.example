# Client-facing API path. Keep this relative to use the same domain in production.
NEXT_PUBLIC_API_BASE_URL=/api

# Persistent application data and structured application logs.
DB_PATH=./data/visitor_logs.db
LOG_DIR=./logs

# Required admin credentials. Replace both values before deploying.
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
